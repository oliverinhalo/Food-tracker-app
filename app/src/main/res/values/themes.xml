<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the real theming. This only has to look right for the moment between launch and
      the first frame, so it just needs the correct background for the system's dark-mode setting
      (see values-night). There is no framework DayNight variant of Theme.Material, hence the split.
    -->
    <style name="Theme.FoodTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!--
      The launch theme. It shows the app's own icon on its own colour instead of a blank window,
      and hands over to Theme.FoodTracker once the stored theme has been read, which is what stops
      a dark-theme user seeing a white frame first.
    -->
    <style name="Theme.FoodTracker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FoodTracker</item>
    </style>
</resources>
