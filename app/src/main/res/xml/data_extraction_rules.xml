<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The encrypted key store is bound to this device's keystore; backing it up would only
             restore undecryptable bytes onto a new device. -->
        <exclude domain="sharedpref" path="secure_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_keys.xml" />
    </device-transfer>
</data-extraction-rules>
